rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper for ID validation
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Matches collection: public read for spectators, athletes, and referees
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isValidId(matchId);
    }

    // Players collection: public roster read for championship standings
    match /players/{playerId} {
      allow read: if true;
      allow write: if isValidId(playerId);
    }

    // Settings collection: Google Sheet sync metadata
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
